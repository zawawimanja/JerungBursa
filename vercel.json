{
  "version": 2,
  "builds": [
    { "src": "smart-money-tracker/api/chat.js", "use": "@vercel/node" },
    { "src": "smart-money-tracker/api/cron-scrape.js", "use": "@vercel/node" },
    { "src": "smart-money-tracker/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/chat", "dest": "/smart-money-tracker/api/chat.js" },
    { "src": "/api/cron-scrape", "dest": "/smart-money-tracker/api/cron-scrape.js" },
    { "src": "/api/cron-alert", "dest": "/smart-money-tracker/api/cron-scrape.js" },
    { "src": "/api/cron-dispatch", "dest": "/smart-money-tracker/api/cron-scrape.js" },
    {
      "src": "/(.*)\\.json",
      "headers": {
        "cache-control": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
      },
      "dest": "/smart-money-tracker/$1.json"
    },
    {
      "src": "/(live_data|fresh_rider_tracker|hot_theme_tracker|daily_equity_tracker|jerung-data)\\.js",
      "headers": {
        "cache-control": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
      },
      "dest": "/smart-money-tracker/$1.js"
    },
    { "src": "/(.*)", "dest": "/smart-money-tracker/$1" }
  ],
  "crons": [
    {
      "path": "/api/cron-scrape?job=morning_alert",
      "schedule": "2 1 * * 1-5"
    },
    {
      "path": "/api/cron-scrape?job=buy_alert",
      "schedule": "15 8 * * 1-5"
    }
  ]
}
